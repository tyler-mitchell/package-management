{
  "name": "@package-management/monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Universal and programmatic package management (pnpm, bun, yarn, npm)",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "check": "pnpm --filter package-management run check",
    "ci:dispatch": "gh workflow run ci.yml",
    "ci:cancel": "gh run cancel",
    "ci:list": "gh run list --limit 10",
    "ci:logs": "gh run view --log-failed",
    "ci:rerun": "gh run rerun",
    "ci:watch": "gh run watch --exit-status",
    "dev": "pnpm --filter=gitdrops run dev",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "patch": "npx pnpm-patch-i",
    "release:add": "bumpy add",
    "release:check": "bumpy check --strict",
    "release:merge": "gh pr merge bumpy/version-packages --squash",
    "release:pr": "gh pr view bumpy/version-packages",
    "release:registry-version": "npm view package-management version",
    "release:status": "bumpy status --json",
    "release:preflight": "node scripts/verify-package.ts",
    "release:verify": "node scripts/verify-release.ts",
    "workflow:check": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 .github/workflows/*.yml"
  },
  "devDependencies": {
    "@antfu/eslint-config": "2.6.3",
    "@gitdrops/eslint": "^0.0.2",
    "@types/node": "^20.5.1",
    "@varlock/bumpy": "1.18.1",
    "npm": "^11.15.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.2"
  }
}
