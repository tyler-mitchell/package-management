{
  "name": "package-management",
  "description": "Simple type-safe utilities for programatically installing and importing packages",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "dev": "unbuild --stub",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest --fileParallelism=false",
    "test:bench": "vitest bench",
    "test:snapshot": "vitest -u --fileParallelism=false",
    "test:silent": "vitest --reporter=dot",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .tsbuildinfo .turbo coverage dist node_modules"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "citty": "^0.1.5",
    "free-types": "^0.12.0",
    "jiti": "^1.21.0",
    "ts-toolbelt": "^9.6.0",
    "tsl": "^0.0.9",
    "tsx": "^4.7.0",
    "type-level-regexp": "^0.1.17",
    "typescript": "7.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.0.1",
    "@arktype/util": "^0.0.26",
    "@clickbar/dot-diver": "^1.0.7",
    "arktype": "2.0.0-dev.1",
    "async-cache-fn": "^0.0.3",
    "error-stack-parser": "^2.1.4",
    "execa": "^10.0.1",
    "find-up": "^8.0.0",
    "globby": "^16.2.4",
    "jsonc-parser": "^3.3.1",
    "local-pkg": "^1.2.1",
    "lru-cache": "^11.5.2",
    "magic-regexp": "^0.11.0",
    "mlly": "^1.5.0",
    "parse-gitignore": "^2.0.0",
    "pathe": "^2.0.3",
    "string-ts": "^2.3.1",
    "ts-regex-builder": "^1.8.2",
    "unstorage": "^1.17.5",
    "workspace-tools": "^0.42.2",
    "yaml": "^2.9.0"
  }
}
