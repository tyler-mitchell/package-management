{
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*.ts",
    "./vitest.config.ts",
    "./build.config.ts"
  ],
  "compilerOptions": {
    // Paths
    // `baseUrl` was removed in TypeScript 7; `paths` entries now resolve
    // relative to this file, which is what they already did here.
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
    },
    "types": [
      "@types/node"
    ],
    // Strictness
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "allowUnusedLabels": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Module
    "resolveJsonModule": true,
    "skipDefaultLibCheck": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Output
    "sourceMap": true,
    "noEmit": true,
    "declaration": true,
    // Environment
    "lib": [
      "esnext"
    ],
    "target": "es2022",
    "module": "esnext",
    // The package ships through a bundler and imports without file extensions,
    // so `bundler` mirrors how Rollup and Vite actually resolve these imports.
    "moduleResolution": "bundler"
  }
}
